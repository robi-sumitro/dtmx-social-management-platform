# DtmX API environment
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://dtmx:dtmx@localhost:5432/dtmx?schema=public

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=supersecret-change-me
JWT_REFRESH_SECRET=supersecret-refresh-change-me
JWT_EXPIRES_IN=15m

# Rate limiting (per IP)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=60

# URLs
# Di Railway, API_URL & FRONTEND_URL otomatis memakai RAILWAY_PUBLIC_DOMAIN
# jika tidak diset. Isi eksplisit hanya jika memakai custom domain.
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
APP_URL=http://localhost:3000
# Wajib daftar origin frontend secara eksplisit (pisah dengan koma).
# Kosongkan untuk menolak semua permintaan lintas-origin (CORS dimatikan).
CORS_ORIGINS=http://localhost:4200

# OAuth (login with platform)
# Authorized redirect URI Google : {API_URL}/api/auth/google/callback
# Authorized redirect URI Facebook: {API_URL}/api/auth/facebook/callback
# Connect (hubungkan akun sosial): Facebook/Instagram & YouTube & TikTok
#   {API_URL}/api/social-accounts/auth/{facebook|youtube|tiktok}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# TikTok Content Posting API (client key & secret) — hanya untuk connect akun (bukan login)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Quota YouTube (proyek GCP = 10.000 unit/hari, dibagi semua channel).
# YOUTUBE_QUOTA_DAILY_LIMIT : cap global proyek (default 9000, sisa buffer)
#   agar tidak sempat menabrak batas Google. Baca = 1 unit, balas/hapus = 50.
# YOUTUBE_USER_DAILY_WRITE_LIMIT : jatah operasi TULIS per user/hari (opsional).
#   0 / dikosongkan = tanpa cap per user (hanya cap global). Contoh 500 = 10 balasan/hari.
YOUTUBE_QUOTA_DAILY_LIMIT=9000
YOUTUBE_USER_DAILY_WRITE_LIMIT=0

# Seed (pnpm db:seed) - akun admin pertama kali
# Catatan: SEED_ADMIN_PASSWORD WAJIB di-set saat NODE_ENV=production.
# Seed tidak berjalan otomatis di produksi; jalankan sekali manual via `pnpm --filter @dtmx/api prisma:seed`.
SEED_ADMIN_EMAIL=admin@dtmx.app
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=DtmX Admin

# SMTP (reset password via email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DtmX <no-reply@dtmx.app>

# Uploads
UPLOAD_DIR=uploads

# AI providers — Dikelola dari Admin Panel > AI Providers (tersimpan di DB).
# Nilai di bawah hanya dipakai sebagai fallback jika belum diatur lewat dashboard admin.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Payment gateways (comma separated active selections)
ENABLED_PAYMENT_METHODS=manual,stripe,tripay,midtrans

# Stripe
STRIPE_SECRET_KEY=
# Wajib: signing secret untuk verifikasi webhook Stripe.
# Buat di Dashboard Stripe > Developers > Webhooks (endpoint: {API_URL}/api/payments/webhook/stripe)
STRIPE_WEBHOOK_SECRET=

# Tripay
TRIPAY_API_KEY=
# Wajib untuk verifikasi signature webhook Tripay (private key dari dashboard Tripay).
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CHANNEL=OVO
TRIPAY_SANDBOX=true

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false