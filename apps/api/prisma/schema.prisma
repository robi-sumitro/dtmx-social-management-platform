// DtmX Prisma Schema
// Generator & datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY & AUTH ============

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String?   @unique
  passwordHash      String?
  fullName          String?
  avatar            String?
  role              String    @default("user") // user | admin
  isActive          Boolean   @default(true)
  oauthProvider     String? // google | facebook (login via platform)
  oauthId           String?
  resetToken        String?
  resetTokenExpires DateTime?
  quotaAi           Int       @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  socialAccounts   SocialAccount[]
  posts            Post[]
  mediaFiles           MediaFile[]
  subscriptions    Subscription[]
  payments         Payment[]
  inboxItems       InboxItem[]
  aiUsages         AiUsage[]
  autoReplies      AutoReplyRule[]

  @@map("users")
}

// ============ SUBSCRIPTION / PLAN / PAYMENT ============

model Plan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  price             Float
  currency          String   @default("USD")
  billingPeriodDays Int      @default(30)
  maxAccounts       Int
  maxPostsPerMonth  Int
  aiPerMonth        Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  status      String             @default("active") // active|pending|cancelled|past_due|expired
  paymentMethod String           @default("manual") // manual|stripe|tripay|midtrans
  paymentProof String?
  startedAt   DateTime?
  expiresAt   DateTime?
  activeAiQuota Int              @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  plan  Plan  @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String?
  userId          String
  planId          String
  amount          Float
  currency        String        @default("IDR")
  method          String        // manual|stripe|tripay|midtrans
  status          String        @default("PENDING") // PENDING|PAID|FAILED|EXPIRED|REFUNDED
  providerRef     String?       // external payment id
  proofFile       String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  plan          Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ============ SOCIAL ACCOUNTS ============

model SocialAccount {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // facebook|instagram|youtube|tiktok
  accountType     String // facebook_page|instagram|youtube_channel|tiktok_account
  accountName     String
  platformId      String
  accessToken     String?
  refreshToken    String?
  tokenType       String   @default("long_lived")
  tokenIssuedAt   DateTime?
  tokenExpiresAt  DateTime?
  instagramId     String?
  avatarUrl       String?
  followersCount  Int      @default(0)
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  posts       PostAccount[]
  publications PostPublication[]
  inboxItems  InboxItem[]

  @@index([userId])
  @@map("social_accounts")
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  title        String?
  caption      String?
  hashtags     String?
  platform     String?
  postType     String   @default("text")
  status       String   @default("draft") // draft|scheduled|publishing|published|failed|cancelled|paused
  scheduledAt  DateTime?
  publishedAt  DateTime?
  overrides    Json?
  allowRepost  Boolean  @default(false)
  errorMessage String?
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id])
  accounts      PostAccount[]
  media         PostMedia[]
  publications  PostPublication[]

  @@index([userId, status])
  @@map("posts")
}

model PostAccount {
  id        String @id @default(cuid())
  postId    String
  accountId String

  post    Post            @relation(fields: [postId], references: [id])
  account SocialAccount   @relation(fields: [accountId], references: [id])

  @@unique([postId, accountId])
  @@map("post_accounts")
}

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  mediaId String
  order   Int    @default(0)

  post  Post  @relation(fields: [postId], references: [id])
  media MediaFile @relation(fields: [mediaId], references: [id])

  @@index([postId])
  @@map("post_media")
}

model PostPublication {
  id        String   @id @default(cuid())
  postId    String
  accountId String
  remoteId  String?
  publishedAt DateTime @default(now())

  post    Post         @relation(fields: [postId], references: [id])
  account SocialAccount @relation(fields: [accountId], references: [id])

  @@index([postId])
  @@index([accountId])
  @@map("post_publications")
}

model MediaFile {
  id           String   @id @default(cuid())
  userId       String
  filename     String
  originalName String
  fileType     String   // image|video
  mimeType     String?
  fileSize     Int
  width        Int?
  height       Int?
  duration     Float?
  thumbnail    String?
  folder       String   @default("general")
  createdAt    DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id])
  postMedia  PostMedia[]

  @@index([userId])
  @@map("media_files")
}

// ============ INBOX (COMMENTS / DMs) ============

model InboxItem {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  kind        String   @default("comment") // comment|dm|mention
  sourceId    String?  // provider message/comment id
  authorName  String?
  authorId    String?
  content     String?
  mediaUrl    String?
  status      String   @default("new") // new|replied|ignored|queued
  repliedAt   DateTime?
  createdAt   DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id])
  account SocialAccount @relation(fields: [accountId], references: [id])

  @@index([userId, status])
  @@index([accountId])
  @@map("inbox_items")
}

model AutoReplyRule {
  id             String   @id @default(cuid())
  userId         String
  accountId      String?
  name           String
  matchType      String   @default("contains") // contains|startsWith|exact|always
  matchText      String?
  replyTemplate  String?
  useAI          Boolean  @default(false)
  aiProvider     String?
  aiPrompt       String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, enabled])
  @@map("auto_reply_rules")
}

// ============ AI USAGE ============

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  feature   String   @default("auto_reply") // auto_reply|content_writer|caption_help
  provider  String?
  accountId String?
  inputTokens   Int    @default(0)
  outputTokens  Int    @default(0)
  prompt    String?
  result    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage")
}

// ============ FEATURE FLAGS (admin activate/deactivate) ============

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. 'ai_replies', 'inbox', 'media_upload', 'scheduling'
  name        String
  description String?
  enabled     Boolean  @default(true)
  metadata    Json?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}