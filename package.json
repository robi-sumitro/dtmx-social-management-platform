{
  "name": "dtmx",
  "version": "1.0.0",
  "private": true,
  "description": "DtmX - AI-powered social media management platform",
  "packageManager": "pnpm@11.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "msgpackr-extract"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "pnpm --filter @dtmx/api prisma:deploy && pnpm --filter @dtmx/api start:prod",
    "build": "pnpm --filter @dtmx/api prisma:generate && pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @dtmx/api prisma:generate",
    "db:migrate": "pnpm --filter @dtmx/api prisma:migrate",
    "db:seed": "pnpm --filter @dtmx/api prisma:seed",
    "db:push": "pnpm --filter @dtmx/api prisma:push",
    "db:studio": "pnpm --filter @dtmx/api prisma:studio",
    "infra:up": "docker compose -f .docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f .docker/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}